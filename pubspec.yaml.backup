name: ligue_panafricaine_neurocitoyens
description: Ligue Panafricaine V9.2 Production Finale - Dashboard complet, QR, arbre, universite
publish_to: 'none'
version: 9.2.0+1
environment:
  sdk: ">=3.3.0 <4.0.0"
dependencies:
  flutter:
    sdk: flutter
  flutter_riverpod: ^2.6.1
  go_router: ^14.8.1
  supabase_flutter: ^2.5.6
  intl: ^0.19.0
  shared_preferences: ^2.2.2
  qr_flutter: ^4.1.0
  firebase_core: ^4.15.0
  cloud_firestore: ^6.10.0
  firebase_auth: ^6.7.0
dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^3.0.0
flutter:
  uses-material-design: true
  assets:
    - assets/geo/africa_50m.json